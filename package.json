{
  "name": "@wolffm/hadoku-aggregator",
  "version": "3.0.4",
  "description": "OSS Issue Aggregator - Browse beginner-friendly issues across open source projects",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-aggregator.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    }
  },
  "scripts": {
    "dev": "node ../hadoku_site/scripts/secrets/dev-vault.mjs -- vite",
    "build": "pnpm build:ui && pnpm build:api",
    "build:ui": "vite build && tsc -p tsconfig.build.json",
    "build:api": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\" && node node_modules/@wolffm/themes/scripts/check-usage.mjs ./src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest run --config vitest.config.api.ts",
    "test:watch": "vitest --config vitest.config.api.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.5",
    "@wolffm/logger": "^1.3.1",
    "@wolffm/prefs-client": "^1.0.6",
    "@wolffm/worker-utils": "^1.4.0",
    "hono": "^4.11.4",
    "marked": "^17.0.3",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@wolffm/logger": ">=1.0.0",
    "@wolffm/task-ui-components": "^3.0.0",
    "@wolffm/themes": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250124.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@wolffm/task-ui-components": "^3.1.0",
    "@wolffm/themes": "^4.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stylelint": "^17.12.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
